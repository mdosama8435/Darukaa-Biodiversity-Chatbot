# ==============================================================================
# DARUKAA.EARTH — AI BIODIVERSITY INTELLIGENCE PLATFORM
# Environment Configuration Template
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="DARUKAA.EARTH AI Biodiversity Intelligence"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# PostgreSQL with pgvector Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=darukaa
POSTGRES_PASSWORD=darukaa_password_change_in_production
POSTGRES_DB=darukaa_earth
# Optional direct DATABASE_URL override. If omitted, built automatically from the above POSTGRES_* vars.
DATABASE_URL=postgresql://darukaa:darukaa_password_change_in_production@localhost:5432/darukaa_earth

# Vector Embeddings Configuration
# Embedding model and dimension are fully configurable to prevent premature vendor/model lock-in.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Knowledge Repository Paths
KNOWLEDGE_SOURCE_DIR=knowledge/sources
KNOWLEDGE_PROCESSED_DIR=knowledge/processed
KNOWLEDGE_METADATA_DIR=knowledge/metadata

# LLM Provider Configuration (Provider-Agnostic)
# Supported options: "openai", "anthropic", "ollama".
# If left blank, the application will not guess or fake AI output, and will raise an explicit configuration error.
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
